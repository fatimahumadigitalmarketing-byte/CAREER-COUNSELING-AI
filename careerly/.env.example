# Anthropic API Key for Claude 3.5 Sonnet ("claude-sonnet-5-5" / "claude-3-5-sonnet-20241022")
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL database URL with pgvector extension enabled
DATABASE_URL=postgresql://careerly_user:careerly_password@localhost:5432/careerly_db

# Multilingual embedding model and matching vector dimension
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
